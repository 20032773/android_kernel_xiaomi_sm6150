#
# minatok20 config fragment for Xiaomi Mi 9T (davinci)
#
# Applied after vendor/sdmsteppe-perf_defconfig and vendor/davinci.config:
#   make vendor/sdmsteppe-perf_defconfig vendor/davinci.config vendor/minatok20.config
#
# SPDX-License-Identifier: GPL-2.0
#

# Kernel name
CONFIG_LOCALVERSION="-minatok20"

# No zram writeback (avoid extra UFS wear)
# CONFIG_ZRAM_WRITEBACK is not set
