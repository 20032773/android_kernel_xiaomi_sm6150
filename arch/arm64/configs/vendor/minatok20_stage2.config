# minatok20 stage 2 config fragment (applied to both variants).
# Each block is an independent toggle; flip a line to disable that item.
# SPDX-License-Identifier: GPL-2.0

# --- TCP BBR as default congestion control (+ fq qdisc) ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"

# --- Drop extra logging (AUDIT and KALLSYMS kept; FTRACE kept for
#     Android tracing / driver trace events) ---
# CONFIG_IPC_LOGGING is not set

# --- Sultan cpu_input_boost: force max freq on touch/wake (clamped to
#     stock policy->max, no overclock). davinci: little=cpus0-5(63),
#     big=cpus6-7(192). MAX_BOOST large -> clamps to stock max. ---
CONFIG_LITTLE_CPU_MASK=63
CONFIG_BIG_CPU_MASK=192
CONFIG_CPU_INPUT_BOOST=y
CONFIG_WAKE_BOOST_DURATION_MS=1000
CONFIG_MAX_BOOST_FREQ_LP=2000000
CONFIG_MAX_BOOST_FREQ_PERF=3000000
CONFIG_MIN_FREQ_LP=0
CONFIG_MIN_FREQ_PERF=0
CONFIG_IDLE_MIN_FREQ_LP=0
CONFIG_IDLE_MIN_FREQ_PERF=0
