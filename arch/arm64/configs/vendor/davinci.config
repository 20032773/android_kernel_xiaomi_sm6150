# Compass
CONFIG_AKM09970=y

# Device
CONFIG_MACH_XIAOMI_DAVINCI=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# SKU
CONFIG_CMDLINE_HWC_IS_PRODUCT_SKU=y

# Step motor
CONFIG_TI_DRV8846=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# Boot Image Packaging (Image.gz-dtb + DTBO)
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_IMG_GZ_DTB=y
CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# SukiSU-Ultra (Zero-Overhead Manual Hook) & SUSFS v1.5.5
CONFIG_OVERLAY_FS=y
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# Scheduler, Touch/DDR Input Boost, 300Hz Timer, MGLRU, LZ4 ZRAM & BBR
CONFIG_SCHED_CASS=y
CONFIG_CPU_BOOST=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
CONFIG_HZ_300=y
# CONFIG_HZ_1000 is not set
CONFIG_HZ=300
CONFIG_NET_SCH_FQ=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ARM64 Cryptographic Extensions (F2FS / File-Based Encryption Acceleration)
CONFIG_ARM64_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y
CONFIG_CRYPTO_CHACHA20_NEON=y

# Compiler Optimization & Clang ThinLTO
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

# Strip Debug, Audit & Tracing Overhead (Preserve DEBUG_FS & SELinux for Wi-Fi/DRM/Android 16)
CONFIG_SECURITY_SELINUX=y
CONFIG_DEBUG_FS=y
# CONFIG_SLUB_DEBUG is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_ENABLE_DEFAULT_TRACERS is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_AUDIT is not set
# CONFIG_AUDITSYSCALL is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_CORESIGHT is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_MSM_TZ_LOG is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_LOCK_STAT is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_PROFILING is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_MSM_SDE_ROTATOR_EVTLOG_DEBUG is not set
# CONFIG_DRM_SDE_EVTLOG_DEBUG is not set
# CONFIG_VIDEO_ADV_DEBUG is not set
